# Configurações de Banco de Dados (Desenvolvimento e Produção)
DATABASE_URL=postgresql://eleicoes_user:eleicoes_pass@localhost:5432/eleicoes_brasil

# Parâmetros de container Docker (dev)
POSTGRES_USER=eleicoes_user
POSTGRES_PASSWORD=eleicoes_pass
POSTGRES_DB=eleicoes_brasil
POSTGRES_PORT=5432

# Modo de fallback SQLite local (se DATABASE_URL não for informada)
SQLITE_DB_PATH=data/eleicoes_brasil.db

# Turso / libSQL (Produção Netlify / Edge para 3.7M Boletins de Urna)
# Obtenha em: turso db show <nome-do-db> --url
VITE_TURSO_DATABASE_URL=libsql://mapa-eleicoes-[seu-usuario].turso.io

# Token de Leitura (Gere com: turso db tokens create <nome-do-db> --read-only)
VITE_TURSO_AUTH_TOKEN=eyJhbGciOi...
